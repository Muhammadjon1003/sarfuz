# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/x-httpd-php
</IfModule>

# Cache control headers
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default: 1 month
  ExpiresDefault "access plus 1 month"
  
  # Images (long cache)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # JavaScript & CSS (vendor chunks - long cache)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  
  # HTML & JSON (short cache - always fresh)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  
  # Manifest & webfont
  ExpiresByType application/x-web-app-manifest+json "access plus 1 month"
  ExpiresByType font/opentype "access plus 1 year"
</IfModule>

# Enable ETags
<IfModule mod_headers.c>
  Header append Cache-Control "public"
  Header set X-UA-Compatible "IE=edge"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Rewrite rules for SPA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rewrite to index.html for SPA routing
  RewriteRule ^(?!sitemap\.xml|robots\.txt|.*\.(js|css|png|jpg|gif|svg|ico|webp|woff|woff2)).*$ index.html [QSA,L]
  
  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Remove www
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Disable directory browsing
<FilesMatch "^\.">
  Order Deny,Allow
  Deny from all
</FilesMatch>

# 404 error page
ErrorDocument 404 /index.html

# Security
<FilesMatch "\.(env|json|xml)$">
  Order Deny,Allow
  Deny from all
</FilesMatch>
